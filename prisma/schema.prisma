// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Legal documents (DPA, IRR, Circulars, etc.)
model LegalDocument {
  id          String       @id @default(cuid())
  type        DocType      // DPA, IRR, ISSUANCE
  subType     IssuanceType? // CIRCULAR, ADVISORY, ORDER, DECISION, RESOLUTION (for ISSUANCE type)
  title       String       // "Data Privacy Act of 2012"
  alias       String       @unique // "DPA 2012" or "NPC Circular 16-01"
  url         String?      // Source URL
  sections    Section[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([type])
  @@index([subType])
}

// Individual sections/articles from each document
model Section {
  id          String         @id @default(cuid())
  documentId  String
  document    LegalDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  
  sectionNum  String         // "Section 13", "Article IV", etc.
  title       String         // "Sensitive Personal Information"
  content     String         @db.Text // Full text content
  
  tags        Tag[]          @relation("SectionToTag")
  
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([documentId])
  @@index([sectionNum])
}

// Tagging system for keyword mapping
model Tag {
  id          String    @id @default(cuid())
  name        String    @unique // "CCTV", "Consent", "Breach", etc.
  description String?   // Optional description
  sections    Section[] @relation("SectionToTag")
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([name])
}

// Track ingestion history for transparency and debugging
model IngestionLog {
  id              String         @id @default(cuid())
  source          String         // "DPA 2012", "IRR 2016", "NPC Circular 16-01", etc.
  sourceUrl       String?        // Original URL
  docType         DocType        // Document type
  status          IngestionStatus
  sectionsCount   Int            @default(0) // Number of sections ingested
  errorMessage    String?        @db.Text
  metadata        Json?          // Additional metadata (file size, scraper version, etc.)
  
  startedAt       DateTime       @default(now())
  completedAt     DateTime?
  
  @@index([docType])
  @@index([status])
  @@index([startedAt])
}

enum DocType {
  DPA       // Data Privacy Act of 2012
  IRR       // Implementing Rules and Regulations
  ISSUANCE  // Circulars, Advisories, Opinions
}
enum IssuanceType {
  CIRCULAR    // NPC Circulars
  ADVISORY    // NPC Advisories  
  ORDER       // NPC Orders
  DECISION    // NPC Decisions
  RESOLUTION  // NPC Resolutions
}
enum IngestionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}
