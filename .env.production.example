# SILIP Production Environment Configuration
# Use this for Portainer deployment - copy to .env.production and update values

# Database Configuration
DB_USER=silip
DB_PASSWORD=your_secure_password_here_change_this
DB_NAME=silip_db
DATABASE_URL=postgresql://silip:your_secure_password_here_change_this@silip-db:5432/silip_db

# Redis Configuration
REDIS_URL=redis://silip-redis:6379

# Deployment Options
# Set to 'true' for fast startup (skip bootstrap on container start)
# Run 'npm run bootstrap' manually when ready to ingest documents
SKIP_BOOTSTRAP=true

# Next.js Configuration
# IMPORTANT: NEXT_PUBLIC_API_URL must be set to your full production URL with HTTPS
# This ensures Swagger UI and API documentation work correctly without CORS errors
NODE_ENV=production
NEXT_PUBLIC_API_URL=https://silip.sanchez.ph/api
NEXT_PUBLIC_BASE_URL=https://silip.sanchez.ph

# Application Configuration
PORT=3000
HOSTNAME=0.0.0.0

# Force Re-ingestion (set to 'true' only when running bootstrap manually)
# FORCE_REINGEST=false

# Google Analytics 4 (Optional - only set if you want analytics)
# Forkers: Leave this commented out or use your own GA ID
# Use GA_ID for Docker runtime configuration (recommended)
# GA_ID=G-6TX1WTB91T
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Gemini API Key (Required for AI features)
# GEMINI_API_KEY=your_api_key_here

# Gemini Model (Optional, defaults to gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash
