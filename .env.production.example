# SILIP Production Environment Configuration
# Use this for Portainer deployment - copy to .env.production and update values

# Database Configuration
DB_USER=silip
DB_PASSWORD=your_secure_password_here_change_this
DB_NAME=silip_db
DATABASE_URL=postgresql://silip:your_secure_password_here_change_this@silip-db:5432/silip_db

# Redis Configuration
REDIS_URL=redis://silip-redis:6379

# Deployment Options
# Set to 'true' for fast startup (skip bootstrap on container start)
# Run 'npm run bootstrap' manually when ready to ingest documents
SKIP_BOOTSTRAP=true

# Next.js Configuration
NODE_ENV=production
NEXT_PUBLIC_API_URL=https://silip.sanchez.ph/api
NEXT_PUBLIC_BASE_URL=https://silip.sanchez.ph

# Application Configuration
PORT=3000
HOSTNAME=0.0.0.0

# Force Re-ingestion (set to 'true' only when running bootstrap manually)
# FORCE_REINGEST=false

